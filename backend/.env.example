# ============================================================
#  CẤU HÌNH BACKEND — copy file này thành .env rồi điền giá trị
#  Không commit file .env lên git.
# ============================================================

# Cổng chạy API
PORT=4000

# Origin của frontend (Vite). Nhiều origin thì ngăn cách bằng dấu phẩy.
CORS_ORIGIN=http://localhost:5173,https://dacntt-web.vercel.app

# URL công khai của frontend — dùng để tạo liên kết trong email
APP_URL=https://dacntt-web.vercel.app

# Khóa ký JWT — tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=doi_thanh_chuoi_bi_mat_that_dai

# ------------------------------------------------------------
#  NEON (khuyến nghị)
#  Vào Neon Console > Connect:
#   - Bật "Connection pooling"  -> copy vào DATABASE_URL
#   - Tắt "Connection pooling"  -> copy vào DIRECT_URL
#  Nếu mạng không hỗ trợ IPv6, có thể để trống DIRECT_URL,
#  script setup sẽ dùng DATABASE_URL.
#  Thay MAT_KHAU_NEON bằng mật khẩu project của bạn.
# ------------------------------------------------------------
DATABASE_URL=postgresql://neondb_owner:MAT_KHAU_NEON@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

DIRECT_URL=postgresql://neondb_owner:MAT_KHAU_NEON@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

PGSSL=require
PG_POOL_MAX=5

# ------------------------------------------------------------
#  EMAIL — chọn 1 trong 2 cách
#
#  CÁCH 1 (KHUYÊN DÙNG KHI DEPLOY RENDER FREE): gửi qua HTTP API (cổng 443).
#  Render free chặn outbound SMTP 25/465/587 nên Gmail SMTP sẽ KHÔNG gửi được.
#  Thứ tự ưu tiên (khi không đặt MAIL_PROVIDER): BREVO_API_KEY > RESEND_API_KEY > SENDGRID_API_KEY > SMTP.
#
#  Brevo (dễ nhất, 300 email/ngày, xác minh 1 địa chỉ gửi là dùng được):
#   1. Tạo tài khoản tại https://www.brevo.com
#   2. Senders & IP > Senders > thêm email gửi và bấm xác minh
#   3. SMTP & API > API Keys > tạo key
#   4. Điền:
#      BREVO_API_KEY=xkeysib-xxxxxxxx
#      MAIL_FROM=GayQuy+ <email-da-xac-minh@gmail.com>
#
#  Resend (cần xác minh tên miền nếu gửi cho người khác):
#      RESEND_API_KEY=re_xxxxxxxx
#      MAIL_FROM=GayQuy+ <no-reply@ten-mien-cua-ban>
#
#  SendGrid (không cần tên miền — xác minh Single Sender):
#      MAIL_PROVIDER=sendgrid
#      SENDGRID_API_KEY=SG.xxxxxxxx
#      MAIL_FROM=GayQuy+ <email-da-xac-minh@gmail.com>
#    Lưu ý: SendGrid free hiện là trial 100 email/ngày trong 60 ngày.
# ------------------------------------------------------------
#  Chọn cứng dịch vụ (tùy chọn). Để trống = tự phát hiện theo key.
#  Giá trị: brevo | resend | sendgrid | smtp | console
MAIL_PROVIDER=
MAIL_FROM=
BREVO_API_KEY=
RESEND_API_KEY=
SENDGRID_API_KEY=

#  CÁCH 2: SMTP — chỉ dùng local/VPS hoặc Render trả phí.
#  Ví dụ Gmail:
#    SMTP_HOST=smtp.gmail.com
#    SMTP_PORT=587
#    SMTP_SECURE=false
#    SMTP_USER=your.email@gmail.com
#    SMTP_PASS=mat-khau-ung-dung-16-ky-tu   (App Password, KHÔNG phải mật khẩu Gmail)
#    SMTP_FROM=GayQuy+ <your.email@gmail.com>
#
#  Ví dụ Resend:
#    SMTP_HOST=smtp.resend.com
#    SMTP_PORT=587
#    SMTP_USER=resend
#    SMTP_PASS=re_xxxxxxxx
#    SMTP_FROM=GayQuy+ <no-reply@ten-mien-cua-ban>
#
#  Để trống SMTP_HOST = chế độ dev: nội dung email/OTP được in ra console backend.
# ------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Thời hạn xác thực email / mã OTP (phút)
EMAIL_VERIFICATION_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=60

# Chỉ dùng local: trả OTP trong response khi chưa cấu hình email (không dùng production)
DEV_SHOW_OTP=false

# Token bí mật để kiểm tra cấu hình email thật:
#   GET /api/health/mail?verify=1&token=<HEALTH_VERIFY_TOKEN>
# Để trống = tắt kiểm tra verify (endpoint vẫn trả cấu hình cơ bản).
HEALTH_VERIFY_TOKEN=
